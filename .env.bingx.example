# BingX Trading Bot Configuration
# Copie este arquivo para .env e configure suas chaves

# ===========================================
# API Configuration
# ===========================================
BINGX_API_KEY=your_bingx_api_key_here
BINGX_API_SECRET=your_bingx_api_secret_here
BINGX_USE_TESTNET=true

# ===========================================
# Trading Configuration
# ===========================================
BINGX_MAX_POSITIONS=3
BINGX_RISK_PER_TRADE=0.02
BINGX_LEVERAGE=10

# ===========================================
# Strategy Configuration
# ===========================================
BINGX_TIMEFRAME=15m
BINGX_SYMBOLS=BTC-USDT,ETH-USDT,BNB-USDT,ADA-USDT,DOT-USDT,MATIC-USDT,LINK-USDT,AVAX-USDT

# ===========================================
# Risk Management
# ===========================================
BINGX_STOP_LOSS_RATIO=0.02
BINGX_TAKE_PROFIT_RATIO=0.04
BINGX_MIN_PROFIT_RATIO=1.5

# ===========================================
# Pattern Detection
# ===========================================
BINGX_PATTERN_TOLERANCE=0.005
BINGX_MIN_PATTERN_POINTS=5

# ===========================================
# Monitoring
# ===========================================
BINGX_CHECK_INTERVAL=60

# ===========================================
# Telegram Notifications (Optional)
# ===========================================
BINGX_TELEGRAM_ENABLED=false
BINGX_TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
BINGX_TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ===========================================
# Configuration Notes
# ===========================================
# BINGX_USE_TESTNET: true para testnet, false para produção
# BINGX_RISK_PER_TRADE: Porcentagem do capital para arriscar por trade (0.02 = 2%)
# BINGX_LEVERAGE: Alavancagem (1-125)
# BINGX_TIMEFRAME: Timeframe para análise (1m, 3m, 5m, 15m, 30m, 1h, 2h, 4h, 6h, 8h, 12h, 1d, 3d, 1w, 1M)
# BINGX_SYMBOLS: Símbolos para trading separados por vírgula
# BINGX_STOP_LOSS_RATIO: Stop loss em porcentagem (0.02 = 2%)
# BINGX_TAKE_PROFIT_RATIO: Take profit em porcentagem (0.04 = 4%)
# BINGX_CHECK_INTERVAL: Intervalo de verificação em segundos
