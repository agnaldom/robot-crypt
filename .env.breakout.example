# 🔧 Configuração da Estratégia de Breakout Avançada
# Copie este arquivo para .env.breakout e configure suas credenciais

# ===== CREDENCIAIS BINGX =====
BINGX_API_KEY=your_bingx_api_key_here
BINGX_API_SECRET=your_bingx_api_secret_here
BINGX_TESTNET=true

# ===== GESTÃO DE RISCO =====
RISK_PER_TRADE=0.01                # 1% por trade
LEVERAGE=20                        # Alavancagem 20x
RISK_REWARD_RATIO=2.0             # Mínimo 1:2
MAX_POSITION_SIZE=0.05            # 5% máximo por posição
MAX_DAILY_LOSS=0.05               # 5% perda máxima diária
MAX_CONCURRENT_POSITIONS=3        # Máximo 3 posições simultâneas

# ===== DETECÇÃO DE BREAKOUT =====
MIN_VOLUME_INCREASE=2.0           # Volume 2x maior que média
LOOKBACK_PERIODS=20               # Períodos para análise S/R
MIN_CONFIDENCE=0.7                # Confiança mínima (70%)
TIMEFRAME=1h                      # Timeframe principal
VOLUME_SMA_PERIOD=20              # Período para SMA do volume

# ===== ANÁLISE DO LIVRO DE ORDENS =====
DEPTH_LEVELS=100                  # Níveis de profundidade
IMBALANCE_THRESHOLD_LONG=1.5      # Ratio mínimo bid/ask para LONG
IMBALANCE_THRESHOLD_SHORT=0.67    # Ratio máximo bid/ask para SHORT
WALL_DETECTION_THRESHOLD=0.3      # 30% do volume para detectar wall
TOP_LEVELS_ANALYSIS=20            # Analisar top 20 níveis

# ===== TRADING =====
TRADING_SYMBOLS=BTC-USDT,ETH-USDT,BNB-USDT,ADA-USDT,DOT-USDT
CHECK_INTERVAL=60                 # Intervalo de verificação (segundos)
POSITION_MONITOR_INTERVAL=30      # Intervalo de monitoramento (segundos)
TRAILING_STOP_THRESHOLD=0.10      # 10% de lucro para trailing stop
TRAILING_STOP_OFFSET=0.02         # 2% de offset para trailing stop

# ===== NOTIFICAÇÕES =====
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

EMAIL_ENABLED=false
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_TO=your_email@gmail.com

# ===== LOGGING =====
LOG_LEVEL=INFO
LOG_FILE=logs/breakout_strategy.log
MAX_LOG_SIZE=10485760             # 10MB
BACKUP_COUNT=5
